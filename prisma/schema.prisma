generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pergunta feita por um visitante à cartomante.
// O sistema apenas registra quem perguntou e o que foi perguntado.
model Pergunta {
  id         String   @id @default(uuid())
  consulente String   @db.VarChar(120)
  pergunta   String   @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("perguntas")
}
