# App
PORT=3000
NODE_ENV=development

# PostgreSQL (usadas pelo docker-compose.dev.yml para subir o container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crud_ais
POSTGRES_PORT=5432

# Database (PostgreSQL) - string de conexão usada pelo Prisma.
# Local: deve refletir as variáveis POSTGRES_* acima quando usando o docker-compose.dev.yml.
# Nuvem: configure DATABASE_URL_REMOTE no provedor de deploy com a string do Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crud_ais?schema=public"
DATABASE_URL_REMOTE=""
